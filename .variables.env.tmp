# rename this file from .variables.env.tmp to .variables.env
NODE_ENV=development

# Atlas 主连接（默认）
ATLAS_DATABASE=your-mongodb-atlas-url

# 兼容旧字段：未配置 ATLAS_DATABASE 时会回退读取 DATABASE
DATABASE=

# 开发备用本地连接（仅在 ALLOW_LOCAL_FALLBACK=true 时生效）
DATABASE_LOCAL=mongodb://127.0.0.1:27017/studyhub_local
ALLOW_LOCAL_FALLBACK=false

PORT=8888

SECRET=hackthoon
KEY=idurar

# // jwt secret 
JWT_SCHEME = jwt
JWT_TOKEN_PREFIX = Bearer
JWT_SECRET = thiscanbechangedlater123654789
JWT_TOKEN_EXPIRATION = 18000000
JWT_TOKEN_HASH_ALGO = SHA-256

# AI 助手（可选）
# OPENAI_API_KEY=sk-xxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1